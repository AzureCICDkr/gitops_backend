server:
  port: 8888


  
  autoconfigure:
    exclude:
      - org.springframework.boot.sql.init.SqlInitializationAutoConfiguration
  sql:
    init:
      mode: never     
      enabled: false 


  redis:
    host: localhost
    port: 6379
    password: ""

  session: 
    store-type: redis  
    timeout: 1800s    

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: ${mysql.user}
    url: jdbc:mysql://localhost:3306/dev_db?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
    password: ${mysql.password}
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: ${google.client_id}
            client-secret: ${google.client_secret}
            scope:
              - email
              - profile
            redirect-uri: http://localhost:8080/login/oauth2/code/google

        provider:
          google:
            authorization-uri: https://accounts.google.com/o/oauth2/v2/auth
            token-uri: https://oauth2.googleapis.com/token
            user-info-uri: https://www.googleapis.com/oauth2/v3/userinfo
            user-name-attribute: sub

logging:
  config: classpath:log4j2.xml
  level:
    root: debug


  # CORS 허용 (React → Spring API)
  web:
    cors:
      allowed-origins: "http://localhost:3001"
      allowed-methods: "GET,POST,PUT,DELETE,OPTIONS"
      allowed-headers: "*"
      allow-credentials: true

mybatis:
  mapper-locations: classpath:/mappers/*.xml
  type-aliases-package: com.example.demo.dto
  configuration:
    map-underscore-to-camel-case: true


